TELEGRAM_BOT_TOKEN=123456789:telegram_bot_token_here

# Optional: comma-separated Telegram chat ids allowed to use the bot.
# Leave empty while testing if you do not need access control.
ALLOWED_CHAT_IDS=

# Scraper limits for one Telegram request.
SCRAPER_MAX_PRODUCTS=80
SCRAPER_MAX_ARCHIVE_PAGES=1
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
SCRAPER_REQUEST_DELAY_MS=700

# WooCommerce defaults used in generated CSV.
WC_DEFAULT_CATEGORY=Uncategorized
WC_DEFAULT_PRODUCT_BRAND=
WC_DEFAULT_CAR_BRAND=
WC_PRICE_MARKUP=0
WC_DEFAULT_STOCK_MODE=backorder

# Optional initial values for first bot launch only.
# After launch, manage these from Telegram with /settings.
WC_CATEGORIES=Uncategorized
WC_PRODUCT_BRANDS=
WC_CAR_BRANDS=

# Button presets for scan depth and product cap.
BOT_ARCHIVE_PAGE_OPTIONS=1;2;3;5
BOT_PRODUCT_LIMIT_OPTIONS=20;40;80;150
